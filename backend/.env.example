# Copy to backend/.env and fill in. backend/.env is git-ignored.

# --- Primary model: Groq free tier (open-weight models). Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Fallback model: Ollama, runs locally and free. Install from https://ollama.com, then: ollama pull qwen2.5:7b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Order in which model providers are tried (comma-separated): groq, ollama
LLM_PROVIDERS=groq,ollama

# --- Web search. Tavily free tier (1,000 credits/month) is used if a key is set; otherwise DuckDuckGo (no key).
TAVILY_API_KEY=

# --- App
DATABASE_PATH=data/premise.db
CORS_ORIGINS=http://localhost:3000
MAX_ASSUMPTIONS_TO_RESEARCH=6
SOURCES_PER_ASSUMPTION=4
